NAK_MODE=demo
NAK_HOST=127.0.0.1
NAK_PORT=8787
NAK_OPEN_SECONDS=8
# For a phone on the same Wi-Fi, bind NAK_HOST=0.0.0.0 and use the laptop's LAN origin.
# NAK_PUBLIC_ORIGIN=http://192.168.1.10:8787

# Sepolia writes require MetaMask confirmation. Keep the RPC URL server-side. Configure only after approved deployment.
# NAK_MODE=sepolia
# NAK_PUBLIC_ORIGIN=https://your-demo-host.example
# NAK_SEPOLIA_RPC_URL=
# NAK_DOOR_KEYS_ADDRESS=
# NAK_CREDENTIAL_REGISTRAR_ADDRESS=
# NAK_T14_TX_HASH=
# NAK_DOOR_RUNTIME_HASH=
# NAK_REGISTRAR_RUNTIME_HASH=
# NAK_GUEST_URL=
