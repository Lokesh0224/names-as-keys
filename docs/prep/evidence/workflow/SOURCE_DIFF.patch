+    ethValueWei: packet.tx.value, gasLimit: packet.tx.gas, maxFeePerGasWei: packet.tx.maxFeePerGas,
+    maxPriorityFeePerGasWei: packet.tx.maxPriorityFeePerGas, inputClass: packet.inputClass };
+}
