+      BigInt(tx.chainId) === CHAIN && BigInt(tx.value) === 0n && tx.input === '0x' && BigInt(receipt.status) === 1n && tx.blockHash === receipt.blockHash && same(receipt.from,this.owner) && same(receipt.to,this.owner) && receipt.logs.length === 0,
