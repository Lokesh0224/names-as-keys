+// Receipt-correction regressions: receipt state, finalized state and latest state
+// are deliberately different. These are synthetic provider snapshots, not ENS writes.
+function divergentReceiptView(f, options = {}) {
+  const original = f.provider.request.bind(f.provider);
+  const calls = [];
+  let latestReads = 0, currentRead = false;
+  const header = number => ({ ...f.provider.header, number: '0x' + number.toString(16), hash: number === 100 ? BLOCK : '0x' + number.toString(16).padStart(64,'0') });
+  f.provider.request = async ({method,params=[]}) => {
+    calls.push({method,params});
+    if (method === 'eth_getBlockByNumber') {
+      if (params[0] === 'latest') return header(++latestReads === 1 ? options.latest ?? 111 : options.freshLatest ?? options.latest ?? 111);
+      if (params[0] === 'finalized') return header(options.finalized ?? 100);
+      const number = Number(BigInt(params[0]));
+      const result = header(number);
+      if (options.reorgCurrent && currentRead && number !== 100) result.hash = '0x' + 'ff'.repeat(32);
+      return result;
+    }
+    if (method === 'eth_call') {
+      const number = Number(BigInt(params[1]));
+      if (number !== 100) currentRead = true;
+      if (options.badStateAt?.includes(number)) return '0x' + '0'.repeat(64);
+    }
+    return original({method,params});
+  };
+  return calls;
+}
+async function pendingReceiptFixture(confirmations = 12, currentPostconditions = false) {
+  const p = packet();
+  if (currentPostconditions) p.currentPostconditions = [{...p.postconditions[0],id:'CURRENT_AUTHORIZATION_STATE'}];
+  const config = policy(); config.confirmations = confirmations;
+  const f = fixture([p],{policy:config}); await submit(f); f.provider.mine(p); return f;
+}
