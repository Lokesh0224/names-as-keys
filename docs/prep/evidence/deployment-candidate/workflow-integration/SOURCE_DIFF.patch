+  await review.prepare('T01');
+  f.emit('accountsChanged');
+  assert.equal(review.journal().entries.T01.status, 'RECHECK_REQUIRED');
+  await assert.rejects(review.reconcile('T01', txHash), /session/);
+  review.close();
+});
