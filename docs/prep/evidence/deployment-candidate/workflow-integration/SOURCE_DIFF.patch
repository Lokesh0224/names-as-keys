+test('real browser entry uses existing account access and exposes only unsigned read actions', async () => {
+  const f = fixture();
+  const nodes = new Map();
+  const element = id => {
+    if (!nodes.has(id)) nodes.set(id, { value: id === 'step' ? 'T01' : '', append() {} });
